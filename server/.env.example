# FixGuide AI backend configuration — copy to server/.env and fill in.
# Both keys are optional: without them the backend answers from the
# built-in offline repair knowledge base (labeled as offline mode)
# and speech-to-text returns an honest 501.

# Claude API (Anthropic) — enables live AI answers on /api/ask
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Whisper (OpenAI) — enables speech-to-text on /api/transcribe
OPENAI_API_KEY=

# Backend port (default 8787)
# PORT=8787
